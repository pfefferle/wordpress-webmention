{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webmention/form",
  "title": "Webmention Form",
  "description": "Let readers send a Webmention by entering the URL of their reply on their own website.",
  "category": "widgets",
  "icon": "admin-comments",
  "keywords": [
    "webmention",
    "indieweb",
    "reply",
    "comment"
  ],
  "textdomain": "webmention",
  "usesContext": [
    "postId",
    "postType"
  ],
  "blockHooks": {
    "core/comments": "after"
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "webmention",
  "render": "file:./render.php"
}